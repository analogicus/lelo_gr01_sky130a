* Measure bandgap
.control

load {cicname}.raw

echo "MEAS_START"

*TRAN

load {cicname}_temp.raw
meas dc vref_max MAX v(vref) from=-40 to=125
meas dc vref_min MIN v(vref) from=-40 to=125
meas dc vref_avg AVG v(vref) from=-40 to=125

meas dc iptat_typ FIND i(@r.xdut.x9.xxa1.xr1_0.rbody[i]) AT=27

echo "MEAS_END"
.endc
