* Measure diffamp_1 transient parameters (unity-gain step response)
.control

load {cicname}.raw

echo "MEAS_START"

*--- Static power consumption (average before step, steady state) ---
let pwr_vec = -i(vdd) * v(vdd_1v8)
meas tran pwr_static avg pwr_vec from=100n to=195n

*--- Supply current ---
meas tran idd_static avg i(vdd) from={t_start}+100n to={t_end}

*--- Output voltage levels (steady state before/after rising step) ---
let vout_vec = v(vout)
meas tran vout_low MIN vout_vec from={t_start}+100n to={t_end}
meas tran vout_high MAX vout_vec from={t_start}+100n to={t_end}

*--- Positive slew rate (max dV/dt during rising edge) ---
let dv_dt = deriv(v(vout))
meas tran sr_pos MAX dv_dt from={t_start}+100n to={t_end}

*--- Negative slew rate (min dV/dt during falling edge, reported negative) ---
meas tran sr_neg MIN dv_dt from={t_start}+100n to={t_end}

*--- Rise/Fall time estimated from slew rate ---
let vswing = vout_high - vout_low
let rise_time = 0.8 * vswing / sr_pos
let fall_time = 0.8 * vswing / abs(sr_neg)
echo "rise_time = $&rise_time"
echo "fall_time = $&fall_time"

echo "MEAS_END"
quit
.endc
